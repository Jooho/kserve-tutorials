{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lib/<name>/<version>/module.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "frozen"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/v[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "frozen": {
      "description": "Once true the module must never change; create the next version instead.",
      "type": "boolean"
    },
    "requires": {
      "description": "Host tools the scripts expect.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scripts": {
      "description": "One-line description per script (file name -> text).",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "owners": {
      "description": "GitHub handles; used for .github/CODEOWNERS.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+(/[A-Za-z0-9._-]+)?$"
      }
    }
  }
}
