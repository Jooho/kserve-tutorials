{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catalog/tags.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "groups",
    "tags"
  ],
  "properties": {
    "groups": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tags": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group",
          "description"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
