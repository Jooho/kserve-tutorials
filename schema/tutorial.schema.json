{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tutorial.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "summary",
    "status",
    "versions",
    "langs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "$ref": "#/$defs/localized"
    },
    "summary": {
      "$ref": "#/$defs/localized"
    },
    "status": {
      "enum": [
        "draft",
        "stable",
        "deprecated",
        "archived"
      ]
    },
    "env": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/v[0-9]+$"
    },
    "uses": {
      "description": "Script modules under lib/<name>/v<N> this tutorial calls.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+/v[0-9]+$"
      }
    },
    "tags": {
      "description": "Search tags; each must be listed in catalog/tags.yaml.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "tested"
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/version"
        },
        "tested": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/version"
          }
        }
      },
      "description": "Versions of the project's product (project.yaml name) this tutorial runs on."
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu": {
          "type": "boolean"
        },
        "cpu": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$"
        }
      }
    },
    "langs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "en"
      },
      "items": {
        "enum": [
          "en",
          "ko"
        ]
      }
    },
    "timeout_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "since": {
          "type": "string"
        },
        "replacement": {
          "type": "string"
        },
        "last_supported_version": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "env_options": {
      "description": "Options for the env (see options in its profile.yaml), e.g. {types: [kserve], mode: standard}.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        ]
      }
    },
    "group": {
      "description": "What kind of tutorial it is: an id from catalog/groups.yaml (G003).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "localized": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "ko": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
