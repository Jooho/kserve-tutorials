{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tutorial.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "status", "kserve", "langs"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"$ref": "#/$defs/localized"},
    "summary": {"$ref": "#/$defs/localized"},
    "status": {"enum": ["draft", "stable", "deprecated", "archived"]},
    "series": {
      "description": "Navigation only. Tutorials in a series must still run on their own.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "order"],
      "properties": {"name": {"type": "string"}, "order": {"type": "integer", "minimum": 0}}
    },
    "env": {"type": "string", "pattern": "^[a-z0-9-]+/v[0-9]+$"},
    "namespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
    "kserve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "tested"],
      "properties": {
        "default": {"$ref": "#/$defs/version"},
        "tested": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/version"}}
      }
    },
    "features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu": {"type": "boolean"},
        "cpu": {"type": "integer", "minimum": 1},
        "memory": {"type": "string", "pattern": "^[0-9]+(Mi|Gi)$"}
      }
    },
    "langs": {"type": "array", "minItems": 1, "uniqueItems": true, "contains": {"const": "en"},
              "items": {"enum": ["en", "ko"]}},
    "timeout_minutes": {"type": "integer", "minimum": 1, "maximum": 300},
    "owners": {"type": "array", "items": {"type": "string"}},
    "deprecation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": {"type": "string", "minLength": 1},
        "since": {"type": "string"},
        "last_supported_kserve": {"$ref": "#/$defs/version"},
        "replacement": {"type": "string"}
      }
    }
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "localized": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object", "required": ["en"], "additionalProperties": false,
         "properties": {"en": {"type": "string", "minLength": 1}, "ko": {"type": "string"}}}
      ]
    }
  }
}
