{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "catalog/collections/<id>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "owners",
    "members"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "ko": {
              "type": "string"
            }
          }
        }
      ]
    },
    "description": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "ko": {
              "type": "string"
            }
          }
        }
      ]
    },
    "owners": {
      "description": "GitHub handles; used for .github/CODEOWNERS.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+(/[A-Za-z0-9._-]+)?$"
      }
    },
    "members": {
      "description": "Tutorial ids in reading order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    }
  }
}
