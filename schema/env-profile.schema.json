{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "envs/<name>/<version>/profile.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "frozen",
    "kserve",
    "requires"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/v[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "frozen": {
      "description": "Once true the profile must never change; create the next version instead.",
      "type": "boolean"
    },
    "kserve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min"
      ],
      "properties": {
        "min": {
          "$ref": "#/$defs/version"
        },
        "max": {
          "$ref": "#/$defs/version"
        }
      }
    },
    "requires": {
      "description": "Host tools the setup script expects.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "description": "Environment variables the setup script reads.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/v[0-9]+$"
    },
    "owners": {
      "description": "GitHub handles; used for .github/CODEOWNERS.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]+(/[A-Za-z0-9._-]+)?$"
      }
    },
    "options": {
      "description": "Settings a tutorial may choose in env_options; the setup step passes them as TUT_ENV_<NAME>.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed",
          "default"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "allowed": {
            "type": "array",
            "minItems": 1
          },
          "default": {}
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
